# Example environment variables for the Recipe app frontend.
# Copy to .env and adjust as needed. Do not commit .env to source control.

# When unset or left blank, the app will use built-in mock data and will not perform network requests.
# For same-origin backend (proxied through the frontend dev server), you can set a relative base like /api
# For cross-origin backend, set the full URL and ensure CORS allows the frontend origin.
REACT_APP_API_BASE=
# Alternate variable name supported by the app (used if REACT_APP_API_BASE is not provided)
REACT_APP_BACKEND_URL=

# Optional other variables exposed by the environment (not required for this app to run)
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
